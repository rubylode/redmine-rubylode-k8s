<% settings_reader = RubylodeK8s::Settings.new(settings) %>
<% if @validation_errors.present? %>
  <div id="errorExplanation" class="rubylode-k8s-errors">
    <ul>
      <% @validation_errors.each do |message| %><li><%= message %></li><% end %>
    </ul>
  </div>
<% end %>
<% scope = "rubylode_k8s.settings" %>
<% page_scope = "rubylode_k8s.settings_page" %>
<% defaults = Redmine::Plugin.find(RubylodeK8s::Settings::PLUGIN_ID).settings[:default] %>
<% text_value = ->(key) { settings[key].nil? ? defaults[key] : settings[key] } %>
<%# Says only whether a variable or a file is there, never what it holds. %>
<% token_state = lambda do |cluster|
     if cluster.in_cluster
       l("#{page_scope}.token_file_#{RubylodeK8s::InClusterAccount.token_file_present? ? 'found' : 'not_found'}")
     elsif !cluster.token_variable.match?(RubylodeK8s::Settings::TOKEN_VARIABLE_PATTERN)
       l("#{page_scope}.token_variable_not_allowed", variable: cluster.token_variable)
     else
       l("#{page_scope}.token_variable_#{cluster.token_set? ? 'set' : 'not_set'}", variable: cluster.token_variable)
     end
   end %>
<%# A variable that is set but holds no certificate makes the cluster unavailable, so it is not called the system trust store. %>
<% certificate_authority_state = lambda do |cluster|
     variable = cluster.certificate_authority_variable
     if cluster.in_cluster
       l("#{page_scope}.certificate_authority_file_#{RubylodeK8s::InClusterAccount.certificate_authority_file_present? ? 'found' : 'not_found'}")
     elsif variable.empty?
       l("#{page_scope}.certificate_authority_system_trust_store")
     elsif !variable.match?(RubylodeK8s::Settings::TOKEN_VARIABLE_PATTERN)
       l("#{page_scope}.certificate_authority_variable_not_allowed", variable: variable)
     elsif !cluster.certificate_authority_variable_set?
       l("#{page_scope}.certificate_authority_variable_not_set", variable: variable)
     elsif RubylodeK8s::SecureTransport.certificates_in(cluster.certificate_authority_pem).empty?
       l("#{page_scope}.certificate_authority_variable_without_certificate", variable: variable)
     else
       l("#{page_scope}.certificate_authority_variable_set", variable: variable)
     end
   end %>
<% column_options = ->(key) { options_for_select([[l("#{page_scope}.column_left"), "left"], [l("#{page_scope}.column_right"), "right"]], text_value.call(key)) } %>
<% status_plugin_present = RubylodeK8s::StatusWidget.status_plugin_present? %>

<%= render partial: "rubylode_k8s/status_plugin_notice" %>

<p>
  <label for="settings_clusters"><%= l("#{scope}.clusters.label") %></label>
  <%= text_area_tag "settings[clusters]", text_value.call("clusters"), rows: 6, cols: 90, id: "settings_clusters", class: "wiki-edit", placeholder: l("#{scope}.clusters.example") %>
  <em class="info"><%= l("#{scope}.clusters.hint") %></em>
</p>

<% clusters = settings_reader.clusters %>
<% if clusters.any? %>
  <ul class="rubylode-k8s-variable-state">
    <% clusters.each do |cluster| %>
      <li><%= l("#{page_scope}.cluster_line", name: cluster.name, token_state: token_state.call(cluster), certificate_authority_state: certificate_authority_state.call(cluster)) %></li>
    <% end %>
  </ul>
<% end %>

<p>
  <label for="settings_links"><%= l("#{scope}.links.label") %></label>
  <%= text_area_tag "settings[links]", text_value.call("links"), rows: 4, cols: 90, id: "settings_links", class: "wiki-edit", placeholder: l("#{scope}.links.example") %>
  <em class="info"><%= l("#{scope}.links.hint") %></em>
</p>

